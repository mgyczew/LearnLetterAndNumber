<Window x:Class="LetterGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Słowotwory" WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        Background="#F4F6FC" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#202945" />
        <SolidColorBrush x:Key="Muted" Color="#77819A" />
        <SolidColorBrush x:Key="Accent" Color="#5B63E8" />
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="24,15" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#5B63E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#4C56CC" />
            <Setter Property="Background" Value="#EEF0FF" />
        </Style>
        <Style x:Key="LetterTile" TargetType="Button">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Margin" Value="7" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#27314E" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E8F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="WordZone" Margin="38,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="4,0,4,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SŁOWOTWORY" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                <TextBlock Text="Ucz się liter przez zabawę" Margin="0,4,0,0" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Ink}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                <TextBlock Text="KATEGORIA" Margin="3,0,0,6" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="CategorySelector" Width="220" Height="36" Padding="12,8" FontSize="17"
                          DisplayMemberPath="Name" SelectionChanged="Category_SelectionChanged" />
                <TextBlock Text="Ponad 200 prostych słów" Margin="3,5,0,0" FontSize="12" Foreground="{StaticResource Muted}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Strefa matematyki" Click="OpenMath_Click" Style="{StaticResource SecondaryButton}" Padding="8,8" Width="145" Margin="0,0,6,0" FontSize="14" />
                    <Button Content="Strefa gier" Click="OpenGames_Click" Style="{StaticResource SecondaryButton}" Padding="8,8" Width="120" FontSize="14" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="2" Margin="8,0" Padding="18,12" Background="White" CornerRadius="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Punkty" Foreground="#77819A" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ScoreText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SoundButton" Content="Dźwięk: włączony" Click="ToggleSound_Click" Style="{StaticResource SecondaryButton}" Padding="12,12" Margin="8,0" />
                <Button Content="Pełny ekran" ToolTip="Przełącz pełny ekran (F11)" Click="ToggleFullScreen_Click" Style="{StaticResource SecondaryButton}" Padding="15,12" Margin="8,0" />
                <Button Content="Wyjdź" Click="Exit_Click" Style="{StaticResource SecondaryButton}" Padding="18,12" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*" />
                <ColumnDefinition Width="1.08*" />
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,14,0" Padding="30" CornerRadius="28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6570F0" Offset="0" />
                        <GradientStop Color="#845BE8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="OBRAZEK I PODPOWIEDŹ" FontSize="12" FontWeight="Bold" Foreground="#DDE0FF" />
                        <TextBlock x:Name="CategoryLabel" Text="Owoce" Margin="0,5,0,0" FontSize="25" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,22" Background="#26FFFFFF" CornerRadius="24" Padding="14">
                        <Grid>
                            <TextBlock x:Name="PictureText" Text="OBRAZEK" FontSize="28" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="PictureImage" Stretch="Uniform" MaxWidth="520" MaxHeight="390"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                   ImageFailed="PictureImage_Failed" />
                            <Border x:Name="ColorSwatch" Width="320" Height="220" CornerRadius="20"
                                    BorderBrush="#6877819A" BorderThickness="5" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="ClueText" Text="Słowo z kategorii owoce" FontSize="21" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock x:Name="ImageCreditText" Margin="0,9,0,0" FontSize="13" Foreground="#E5E5FF" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="14,0,0,0" Padding="32" Background="White" CornerRadius="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="UŁÓŻ SŁOWO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="Wybierz litery we właściwej kolejności" Margin="0,5,0,0" FontSize="18" Foreground="{StaticResource Muted}" />
                        <Button x:Name="ListenButton" Content="Odsłuchaj słowo" Click="ListenWord_Click" Style="{StaticResource SecondaryButton}"
                                Padding="14,10" Margin="0,10,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="TWOJA ODPOWIEDŹ" HorizontalAlignment="Center" Margin="0,0,0,10" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                        <ItemsControl x:Name="AnswerPanel" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="StatusText" Text="" Margin="0,12,0,8" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="LITERY" HorizontalAlignment="Center" Margin="0,14,0,4" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                        <ItemsControl x:Name="LetterBank" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Cofnij" Click="Undo_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Wyczyść" Click="Clear_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                            <Button x:Name="CheckButton" Content="Sprawdź" Click="Check_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Dalej" Click="Next_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                    </Grid>
                </Grid>
            </Border>

        </Grid>
        </Grid>

        <Grid x:Name="MathZone" Margin="38,28" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="4,0,4,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MAŁY MATEMATYK" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="Liczymy, ćwiczymy i zdobywamy punkty" Margin="0,4,0,0" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Margin="8,0" Padding="18,12" Background="White" CornerRadius="16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Punkty" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MathScoreText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="MathSoundButton" Content="Dźwięk: włączony" Click="ToggleSound_Click" Style="{StaticResource SecondaryButton}" Padding="12,12" Margin="8,0" />
                    <Button Content="Wróć do liter" Click="OpenWords_Click" Style="{StaticResource SecondaryButton}" Padding="15,12" Margin="8,0" />
                    <Button Content="Strefa gier" Click="OpenGames_Click" Style="{StaticResource SecondaryButton}" Padding="15,12" Margin="8,0" />
                    <Button Content="Pełny ekran" ToolTip="Przełącz pełny ekran (F11)" Click="ToggleFullScreen_Click" Style="{StaticResource SecondaryButton}" Padding="15,12" Margin="8,0" />
                    <Button Content="Wyjdź" Click="Exit_Click" Style="{StaticResource SecondaryButton}" Padding="18,12" />
                </StackPanel>
            </Grid>

            <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,22">
                <Button x:Name="NumbersModeButton" Content="Liczby 1–1000" Tag="Numbers" Click="MathMode_Click" Style="{StaticResource PrimaryButton}" Width="190" Margin="6" />
                <Button x:Name="AdditionModeButton" Content="Dodawanie" Tag="Addition" Click="MathMode_Click" Style="{StaticResource SecondaryButton}" Width="170" Margin="6" />
                <Button x:Name="SubtractionModeButton" Content="Odejmowanie" Tag="Subtraction" Click="MathMode_Click" Style="{StaticResource SecondaryButton}" Width="170" Margin="6" />
                <Button x:Name="MultiplicationModeButton" Content="Mnożenie" Tag="Multiplication" Click="MathMode_Click" Style="{StaticResource SecondaryButton}" Width="170" Margin="6" />
                <Button x:Name="DivisionModeButton" Content="Dzielenie" Tag="Division" Click="MathMode_Click" Style="{StaticResource SecondaryButton}" Width="170" Margin="6" />
            </WrapPanel>

            <Border Grid.Row="2" Padding="34" Background="White" CornerRadius="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="MathLessonTitle" Text="Poznaj liczby" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                        <TextBlock x:Name="MathLessonHint" Text="Uczymy się po kolei od 1 do 1000." Margin="0,5,0,0" FontSize="17" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="NumberLearningPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="POZNAJ LICZBĘ" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            <TextBlock x:Name="MathNumberValue" Text="1" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="96" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock x:Name="MathNumberSpelling" Text="jeden" Margin="0,0,0,8" HorizontalAlignment="Center" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            <Border Margin="0,4,0,12" Padding="14,10" Background="#F6F7FF" CornerRadius="16">
                                <StackPanel>
                                    <WrapPanel x:Name="NumberDotsPanel" Width="280" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="NumberPlaceValueText" Margin="0,4,0,0" HorizontalAlignment="Center"
                                               FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="MathNumberProgress" Text="Liczba 1 z 1000" Margin="0,0,0,20" HorizontalAlignment="Center" FontSize="16" Foreground="{StaticResource Muted}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Poprzednia" Click="PreviousNumber_Click" Style="{StaticResource SecondaryButton}" Margin="5" />
                                <Button x:Name="MathReadNumberButton" Content="Odsłuchaj liczbę" Click="ReadNumber_Click" Style="{StaticResource SecondaryButton}" Margin="5" />
                                <Button Content="Losuj liczbę" Click="RandomNumber_Click" Style="{StaticResource SecondaryButton}" Margin="5" />
                                <Button Content="Następna" Click="NextNumber_Click" Style="{StaticResource PrimaryButton}" Margin="5" />
                            </StackPanel>
                            <Button Content="Sprawdź się" Click="StartNumberQuiz_Click" Style="{StaticResource PrimaryButton}"
                                    Margin="0,12,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="NumberQuizPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="SPRAWDŹ SIĘ" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            <TextBlock x:Name="NumberQuizScoreText" Text="Dobre odpowiedzi: 0" Margin="0,6,0,14"
                                       HorizontalAlignment="Center" FontSize="16" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="NumberQuizQuestionText" Text="Ile jest kropek?" MaxWidth="850"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="34" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <WrapPanel x:Name="NumberQuizDotsPanel" Width="280" Margin="0,14,0,0"
                                       HorizontalAlignment="Center" Visibility="Collapsed" />
                            <ItemsControl x:Name="NumberQuizAnswers" Margin="0,18,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="NumberQuizStatusText" Text="" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource Muted}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button x:Name="NumberQuizReadButton" Content="Odsłuchaj" Click="ReadNumberQuizQuestion_Click"
                                        Style="{StaticResource SecondaryButton}" Margin="5" />
                                <Button x:Name="NextNumberQuizButton" Content="Następne pytanie" Click="NextNumberQuiz_Click"
                                        Style="{StaticResource PrimaryButton}" Margin="5" IsEnabled="False" />
                                <Button Content="Wróć do liczby" Click="ReturnToNumberLearning_Click"
                                        Style="{StaticResource SecondaryButton}" Margin="5" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="MathExercisePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="MathQuestionText" Text="2 + 3 = ?" HorizontalAlignment="Center" FontSize="64" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <Button x:Name="MathReadQuestionButton" Content="Przeczytaj zadanie" Click="ReadMathQuestion_Click" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                            <ItemsControl x:Name="MathAnswers" Margin="0,24,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="MathStatusText" Text="" Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="MathProgressText" Text="" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <Grid x:Name="GameZone" Margin="38,28" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="4,0,4,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="STREFA GIER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="Ćwicz słowa i baw się literami" Margin="0,4,0,0" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Wróć do liter" Click="OpenWords_Click" Style="{StaticResource SecondaryButton}" Padding="15,12" Margin="8,0" />
                    <Button Content="Matematyka" Click="OpenMath_Click" Style="{StaticResource SecondaryButton}" Padding="15,12" Margin="8,0" />
                    <Button x:Name="GameSoundButton" Content="Dźwięk: włączony" Click="ToggleSound_Click" Style="{StaticResource SecondaryButton}" Padding="12,12" Margin="8,0" />
                    <Button Content="Pełny ekran" ToolTip="Przełącz pełny ekran (F11)" Click="ToggleFullScreen_Click" Style="{StaticResource SecondaryButton}" Padding="15,12" Margin="8,0" />
                    <Button Content="Wyjdź" Click="Exit_Click" Style="{StaticResource SecondaryButton}" Padding="18,12" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="GameMenuPanel" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border Width="340" Height="260" Margin="12" Padding="24" Background="White" CornerRadius="26">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SŁOWO PO SŁOWIE" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Ułóż jedno krótkie słowo. Pomogą Ci obrazek i nazwa kategorii." Margin="0,12,0,22" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Button Content="Zagraj" Click="StartWordChain_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    <Border Width="340" Height="260" Margin="12" Padding="24" Background="White" CornerRadius="26">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WĘŻYK LITEROWY" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Zbieraj litery i steruj wężykiem za pomocą strzałek." Margin="0,12,0,22" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Button Content="Zagraj" Click="StartSnakeGame_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    <Border Width="340" Height="260" Margin="12" Padding="24" Background="White" CornerRadius="26">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DOPASUJ OBRAZKI" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Dopasuj obrazki do nazw ułożonych z rozsypanych liter." Margin="0,12,0,22" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Button Content="Zagraj" Click="StartPictureMatch_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    <Border Width="340" Height="260" Margin="12" Padding="24" Background="White" CornerRadius="26">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RUCHOMY ALFABET" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Układaj słowa z liter na trzech poziomach trudności." Margin="0,12,0,22" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Button Content="Zagraj" Click="StartAlphabetGame_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    <Border Width="340" Height="260" Margin="12" Padding="24" Background="White" CornerRadius="26">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="POSZUKIWANIE SKARBÓW" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Czytaj słowa i szukaj pasujących przedmiotów w domu." Margin="0,12,0,22" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Button Content="Zagraj" Click="StartTreasureHunt_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    <Border Width="340" Height="260" Margin="12" Padding="24" Background="White" CornerRadius="26">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SŁOWNE BINGO" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Słuchaj losowanych słów i zaznaczaj je na planszy." Margin="0,12,0,22" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Button Content="Zagraj" Click="StartWordBingo_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    <Border Width="340" Height="260" Margin="12" Padding="24" Background="White" CornerRadius="26">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="POLICZ KROPKI" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Policz obiekty na planszy i wybierz właściwą liczbę." Margin="0,12,0,22" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Button Content="Zagraj" Tag="Count" Click="StartNumberGame_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    <Border Width="340" Height="260" Margin="12" Padding="24" Background="White" CornerRadius="26">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ZNAJDŹ CYFRĘ" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Posłuchaj polecenia i wskaż właściwą cyfrę." Margin="0,12,0,22" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Button Content="Zagraj" Tag="Find" Click="StartNumberGame_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    <Border Width="340" Height="260" Margin="12" Padding="24" Background="White" CornerRadius="26">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="UŁÓŻ LICZBĘ" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Ułóż liczbę zapisaną słownie, wybierając cyfry po kolei." Margin="0,12,0,22" FontSize="17" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <Button Content="Zagraj" Tag="Build" Click="StartNumberGame_Click" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Border>
                    </WrapPanel>
                </ScrollViewer>

                <Border x:Name="WordChainPanel" Padding="34" Background="White" CornerRadius="28" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SŁOWO PO SŁOWIE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                <TextBlock x:Name="WordChainProgressText" Text="Runda 1 · słowo 3-literowe" Margin="0,5,0,0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Wróć do gier" Click="BackToGameMenu_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="UŁÓŻ SŁOWO Z LITER" HorizontalAlignment="Center" Margin="0,0,0,8" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                            <Border Width="220" Height="138" Margin="0,0,0,8" Background="#F4F6FC" CornerRadius="20" Padding="8">
                                <Grid>
                                    <TextBlock x:Name="WordChainEmojiText" Text="🐾" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="WordChainImage" Stretch="Uniform" MaxWidth="204" MaxHeight="122" Visibility="Collapsed" ImageFailed="WordChainImage_ImageFailed" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="WordChainImageCreditText" Margin="0,0,0,4" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" Visibility="Collapsed" />
                            <TextBlock x:Name="WordChainCategoryText" Text="Kategoria" HorizontalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            <TextBlock x:Name="WordChainClueText" Text="Podpowiedź" HorizontalAlignment="Center" Margin="0,2,0,5" FontSize="15" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock x:Name="WordChainBankHint" Text="Ułóż nazwę pasującą do obrazka." HorizontalAlignment="Center" Margin="0,0,0,4" FontSize="15" Foreground="{StaticResource Muted}" />
                            <ItemsControl x:Name="WordChainAnswerPanel" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="WordChainStatusText" Text="" Margin="0,16,0,8" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="LITERY" HorizontalAlignment="Center" Margin="0,14,0,4" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                            <ItemsControl x:Name="WordChainLetterBank" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WordChainScoreText" Text="Punkty: 0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Cofnij" Click="UndoWordChainLetter_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                <Button Content="Wyczyść" Click="ClearWordChain_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                <Button x:Name="CheckWordChainButton" Content="Sprawdź" Click="CheckWordChain_Click" Style="{StaticResource PrimaryButton}" />
                                <Button x:Name="NextWordChainButton" Content="Następna runda" Click="NextWordChain_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="SnakeGamePanel" Padding="28" Background="White" CornerRadius="28" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="WĘŻYK LITEROWY" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                <TextBlock x:Name="SnakeGoalText" Text="Zbieraj litery, aby ułożyć słowo" Margin="0,5,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Wróć do gier" Click="BackToGameMenu_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Grid.Row="1" Margin="0,16" Background="#EEF0FF" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="SnakeBoard" Width="720" Height="432" ClipToBounds="True" Focusable="True" />
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SnakeStatusText" Text="Użyj strzałek, aby sterować wężykiem." FontSize="17" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="SnakeScoreText" Text="Punkty: 0" Margin="0,4,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="StartSnakeButton" Content="Rozpocznij" Click="StartSnakeRound_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                                <Button Content="Wróć do gier" Click="BackToGameMenu_Click" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="PictureMatchPanel" Padding="28" Background="White" CornerRadius="28" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DOPASUJ OBRAZKI" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Ułóż nazwę każdego obrazka z rozsypanych liter" Margin="0,5,0,0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Wróć do gier" Click="BackToGameMenu_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="PictureMatchCardsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ScrollViewer>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PictureMatchStatusText" Text="" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="PictureMatchScoreText" Text="Punkty: 0" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <Button Content="Nowa plansza" Click="StartPictureMatch_Click" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="NumberGamePanel" Padding="34" Background="White" CornerRadius="28" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="NumberGameTitleText" Text="GRA LICZBOWA" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                <TextBlock x:Name="NumberGamePromptText" Text="" Margin="0,5,0,0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Wróć do gier" Click="BackToGameMenu_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <WrapPanel x:Name="NumberGameDotsPanel" Width="420" HorizontalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="NumberGameBuiltNumberText" Text="" Margin="0,10,0,10" HorizontalAlignment="Center" FontSize="56" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            <ItemsControl x:Name="NumberGameChoices" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="NumberGameStatusText" Text="" Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NumberGameScoreText" Text="Punkty: 0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ClearNumberGameButton" Content="Wyczyść" Click="ClearNumberGameAnswer_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Visibility="Collapsed" />
                                <Button x:Name="CheckNumberGameButton" Content="Sprawdź" Click="CheckNumberGameAnswer_Click" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" />
                                <Button x:Name="NextNumberGameButton" Content="Następne" Click="NextNumberGameQuestion_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="AlphabetGamePanel" Padding="28" Background="White" CornerRadius="28" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RUCHOMY ALFABET" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Ułóż słowo z ruchomych liter" Margin="0,5,0,0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Wróć do gier" Click="BackToGameMenu_Click" Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8">
                                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Button Content="Poziom 1" Tag="1" Click="AlphabetLevel_Click" Style="{StaticResource SecondaryButton}" Margin="4" />
                                    <Button Content="Poziom 2" Tag="2" Click="AlphabetLevel_Click" Style="{StaticResource SecondaryButton}" Margin="4" />
                                    <Button Content="Poziom 3" Tag="3" Click="AlphabetLevel_Click" Style="{StaticResource SecondaryButton}" Margin="4" />
                                </WrapPanel>
                                <TextBlock Text="Poziom 1: krótkie słowa · poziom 2: trudniejsze głoski · poziom 3: dłuższe słowa. „Sz”, „cz”, „rz” i „ch” są osobnymi kafelkami." MaxWidth="820" Margin="0,0,0,10" HorizontalAlignment="Center" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                                <Border Width="180" Height="110" Background="#F4F6FC" CornerRadius="20" Padding="8">
                                    <TextBlock x:Name="AlphabetEmojiText" Text="🐾" FontSize="58" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="AlphabetCategoryText" Text="Kategoria" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                <TextBlock x:Name="AlphabetClueText" Text="Podpowiedź" Margin="0,2,0,8" HorizontalAlignment="Center" FontSize="16" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                                <ItemsControl x:Name="AlphabetAnswerPanel" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="AlphabetStatusText" Margin="0,8,0,4" HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" />
                                <ItemsControl x:Name="AlphabetLetterBank" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="AlphabetScoreText" Text="Punkty: 0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Button Content="Odsłuchaj" Click="ListenAlphabetWord_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                <Button Content="Cofnij" Click="UndoAlphabetLetter_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                <Button Content="Wyczyść" Click="ClearAlphabetLetters_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                <Button x:Name="CheckAlphabetButton" Content="Sprawdź" Click="CheckAlphabetWord_Click" Style="{StaticResource PrimaryButton}" Margin="3" />
                                <Button x:Name="NextAlphabetButton" Content="Następne słowo" Click="NextAlphabetWord_Click" Style="{StaticResource PrimaryButton}" Margin="3" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="TreasureHuntPanel" Padding="30" Background="White" CornerRadius="28" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="POSZUKIWANIE SKARBÓW" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Znajdź przedmiot w domu" Margin="0,5,0,0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Wróć do gier" Click="BackToGameMenu_Click" Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TreasureProgressText" Text="Skarb 1 z 12" HorizontalAlignment="Center" FontSize="16" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="TreasureEmojiText" Text="🏠" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="76" />
                            <TextBlock x:Name="TreasureWordText" Text="STÓŁ" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="46" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="Przeczytaj słowo, przyklej karteczkę na przedmiocie i wróć tutaj." Margin="0,4,0,18" HorizontalAlignment="Center" FontSize="18" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                            <Border MaxWidth="720" Padding="18,12" Background="#F4F6FC" CornerRadius="16">
                                <StackPanel>
                                    <TextBlock Text="MISJA SPECJALNA" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="TreasureMissionText" Text="Weź kubek i połóż go na stole." Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Ink}" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TreasureStatusText" Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TreasureFoundCountText" Text="Znalezione: 0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Button Content="Odsłuchaj" Click="ListenTreasureWord_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                <Button Content="Inna misja" Click="NextTreasureMission_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                <Button Content="Pomiń" Click="SkipTreasureWord_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                <Button x:Name="FoundTreasureButton" Content="Znalazłem skarb" Click="MarkTreasureFound_Click" Style="{StaticResource PrimaryButton}" Margin="3" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="WordBingoPanel" Padding="28" Background="White" CornerRadius="28" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SŁOWNE BINGO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Słuchaj i zaznaczaj słowa" Margin="0,5,0,0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Wróć do gier" Click="BackToGameMenu_Click" Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel HorizontalAlignment="Center" Margin="8">
                                <TextBlock Text="Wybierz planszę, losuj słowo i kliknij pasujące pole. Zaznacz trzy pola w rzędzie, kolumnie lub po przekątnej." MaxWidth="800" Margin="0,0,0,10" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                                <WrapPanel x:Name="WordBingoBoardChoices" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Button Content="Plansza 1" Tag="1" Click="SelectWordBingoBoard_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                    <Button Content="Plansza 2" Tag="2" Click="SelectWordBingoBoard_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                    <Button Content="Plansza 3" Tag="3" Click="SelectWordBingoBoard_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                    <Button Content="Plansza 4" Tag="4" Click="SelectWordBingoBoard_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                </WrapPanel>
                                <TextBlock Text="LOSOWANE SŁOWO" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="WordBingoCalledWordText" Text="Naciśnij „Losuj słowo”" Margin="0,3,0,8" HorizontalAlignment="Center" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                <UniformGrid x:Name="WordBingoBoard" Rows="3" Columns="3" HorizontalAlignment="Center" />
                                <TextBlock x:Name="WordBingoStatusText" Text="" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="WordBingoProgressText" Text="Plansza 1 · słowo 0 z 14" VerticalAlignment="Center" FontSize="17" Foreground="{StaticResource Muted}" />
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Button Content="Odsłuchaj" Click="ListenBingoCall_Click" Style="{StaticResource SecondaryButton}" Margin="3" />
                                <Button x:Name="NextBingoCallButton" Content="Losuj słowo" Click="NextBingoCall_Click" Style="{StaticResource PrimaryButton}" Margin="3" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
